# ============================================================
# Custom Suricata Rules : Network Sentinel Project
# ============================================================

# Custom Rule 1: Nmap Port Scan Detection
alert tcp 192.168.1.156 any -> 192.168.1.2 any (msg:"Custom Rule: Nmap Port Scan Detected"; flags:S; threshold: type threshold, track by_src, count 20, seconds 5; sid:1000001; rev:1;)

# Custom Rule 2: Hydra Brute-Force Detection
alert http 192.168.1.156 any -> 192.168.1.2 80 (msg:"Custom Rule: Hydra Brute-Force Detected"; content:"Authorization: Basic"; threshold: type threshold, track by_src, count 10, seconds 5; sid:1000002; rev:1;)