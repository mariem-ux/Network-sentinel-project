# ============================================================
# Custom Suricata Rules : Network Sentinel Project
# ============================================================

# Custom Rule 1: Nmap Port Scan Detection
alert tcp 10.0.2.30 any -> 10.0.2.10 any (msg:"Custom Rule: Nmap Port Scan Detected"; flags:S; threshold: type threshold, track by_src, count 5, seconds 5; sid:1000001; rev:1;)

# Custom Rule 2: Hydra Brute-Force Detection
alert http 10.0.2.30 any -> 10.0.2.10 80 (msg:"Custom Rule: Hydra Brute-Force Detected"; content:"Authorization: Basic"; threshold: type threshold, track by_src, count 5, seconds 5; sid:1000002; rev:1;)
